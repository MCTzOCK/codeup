{
  "compilerOptions": {
    "target": "es2022",
    "declaration": true,
    "lib": ["DOM", "es2022", "DOM.Iterable"],
    "module": "NodeNext",
    "moduleDetection": "force",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "strict": true,
    "rootDir": "src",
    "outDir": "dist",
    "jsx": "react-jsx"
  }
}
