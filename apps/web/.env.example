# MongoDB
MONGO_URI=mongodb://user:password@localhost/codeup?authMechanism=DEFAULT&ssl=false&authSource=admin

# SMTP
SMTP_HOST=mail.mydomain.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=no-reply@mydomain.com
SMTP_PASSWORD=mySecureSMTPPassword

# JWT
JWT_SECRET=aVerySecureSecret

# SSO - GitHub
GITHUB_CLIENT_ID=a_valid_client_id
GITHUB_CLIENT_SECRET=a_valid_github_client_secret
GITHUB_REDIRECT_URI=http://mydomain.com/api/sso/github

# SSO - Gitlab
GITLAB_CLIENT_ID=a_valid_client_id
GITLAB_REDIRECT_URI=http://mydomain.com/api/sso/gitlab

# ConfigCat
CONFIGCAT_KEY=some_configcat_key